# Universe 2200 Configuration

# AI Provider (openai, openrouter, anthropic)
AI_PROVIDER=openrouter

# API Key (Required for AI features)
# OpenAI: sk-...
OpenRouter:
# Anthropic: sk-ant-...
LLM_API_KEY=sk-or-your-key-here

# AI Model
# OpenAI: gpt-4o, gpt-4o-mini
OpenRouter: openai/gpt-oss-120b:free, deepseek/deepseek-r1-0528:free
# Anthropic: claude-3-opus-20240229
AI_MODEL=openai/gpt-4o-mini

# Base URL (Optional - for local LLMs or custom proxies)
# OpenRouter Default: https://openrouter.ai/api/v1
# Local Example: http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1
